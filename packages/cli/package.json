{
  "name": "dovo-terminal",
  "version": "0.1.0",
  "description": "Terminal client for Dovo Studio: browse projects, run agent tasks, and answer approvals from the CLI, rendered with pi-tui differential rendering.",
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "agent",
    "dovo"
  ],
  "license": "MIT",
  "author": {
    "name": "raulcorreia7",
    "url": "https://github.com/raulcorreia7"
  },
  "maintainers": [
    {
      "name": "Dovo Studio",
      "url": "https://github.com/dovocode/dovo-studio"
    }
  ],
  "contributors": [
    {
      "name": "Dominic Vonk",
      "url": "https://github.com/DominicVonk",
      "description": "Dovo Studio \u2014 the runtime, protocol, and name"
    }
  ],
  "type": "module",
  "bin": {
    "dovo": "./src/cli.ts"
  },
  "scripts": {
    "demo": "node src/cli.ts --demo",
    "serve": "node src/cli.ts serve --demo",
    "smoke": "node test/smoke.ts",
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@dovo-terminal/a2a": "workspace:*",
    "@dovo-terminal/client": "workspace:*",
    "@dovo-terminal/orchestrator": "workspace:*",
    "@dovo-terminal/protocol": "workspace:*",
    "@dovo-terminal/server": "workspace:*",
    "@dovo-terminal/tui": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^1.5.0",
    "@xterm/headless": "^6.0.0"
  }
}
